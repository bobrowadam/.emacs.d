(dolist (spec '((modus-kanagawa-wave-palette-overrides "Wave")
                (modus-kanagawa-dragon-palette-overrides "Dragon")
                (modus-kanagawa-lotus-palette-overrides "Lotus")))
  (eval `(defcustom ,(car spec) nil
           ,(format "Palette overrides for Modus Kanagawa %s." (cadr spec))
           :group 'modus-kanagawa
           :type '(repeat (list symbol (choice symbol string))))))

(defconst modus-kanagawa-custom-faces
  '(
    ;; Kanagawa typography and canonical syntax emphasis.
    `(bold ((,c :foreground ,kanagawa-bold :weight bold)))
    `(bold-italic ((,c :foreground ,kanagawa-bold :weight bold :slant italic)))
    `(italic ((,c :foreground ,kanagawa-keyword :slant italic)))
    `(font-lock-comment-face ((,c :foreground ,kanagawa-comment :slant italic)))
    `(font-lock-comment-delimiter-face ((,c :foreground ,kanagawa-comment :slant italic)))
    `(font-lock-function-name-face ((,c :foreground ,kanagawa-function :weight normal)))
    `(font-lock-keyword-face ((,c :foreground ,kanagawa-keyword :weight bold :slant italic)))
    `(font-lock-variable-name-face ((,c :foreground ,fg-main)))
    `(highlight ((,c :foreground ,fg-main :background ,bg-dim)))
    `(shadow ((,c :foreground ,kanagawa-level-3)))

    ;; Window chrome.
    `(separator-line
      ((default :extend t)
       (((type tty)) :foreground ,border :strike-through t)
       (t :height 0.1 :background ,border :foreground ,border)))
    `(fringe ((,c :background ,bg-main :foreground ,kanagawa-level-3)))
    `(margin ((,c :background ,bg-main)))
    `(line-number ((,c :background ,bg-line-number-inactive :foreground ,fg-line-number-inactive)))
    `(line-number-current-line ((,c :background ,bg-line-number-active :foreground ,fg-line-number-active)))
    `(header-line ((,c :background ,bg-dim :foreground ,fg-main :box nil)))
    `(header-line-inactive ((,c :background ,bg-main :foreground ,kanagawa-level-3 :box nil)))
    `(mode-line ((,c :background ,bg-mode-line-active :foreground ,fg-mode-line-active :box nil)))
    `(mode-line-active ((,c :background ,bg-mode-line-active :foreground ,fg-mode-line-active :box nil)))
    `(mode-line-inactive ((,c :background ,bg-mode-line-inactive :foreground ,fg-mode-line-inactive :box nil)))
    `(vertical-border ((,c :background ,bg-main :foreground ,border)))
    `(window-divider ((,c :background ,border :foreground ,border)))
    `(window-divider-first-pixel ((,c :background ,border :foreground ,border)))
    `(window-divider-last-pixel ((,c :background ,border :foreground ,border)))

    ;; Markdown and markdown-ts-mode.
    `(markdown-header-face ((,c :foreground ,kanagawa-identifier :weight normal)))
    `(markdown-header-face-1 ((,c :inherit markdown-header-face :foreground ,kanagawa-identifier)))
    `(markdown-header-face-2 ((,c :inherit markdown-header-face :foreground ,kanagawa-function)))
    `(markdown-header-face-3 ((,c :inherit markdown-header-face :foreground ,kanagawa-keyword)))
    `(markdown-header-face-4 ((,c :inherit markdown-header-face :foreground ,kanagawa-type)))
    `(markdown-header-face-5 ((,c :inherit markdown-header-face :foreground ,kanagawa-special-1)))
    `(markdown-header-face-6 ((,c :inherit markdown-header-face :foreground ,kanagawa-comment)))
    `(markdown-bold-face ((,c :inherit bold)))
    `(markdown-italic-face ((,c :inherit italic)))
    `(markdown-code-face ((,c :inherit fixed-pitch :background ,kanagawa-block-bg)))
    `(markdown-inline-code-face ((,c :inherit fixed-pitch :foreground ,kanagawa-type :background unspecified)))
    `(markdown-pre-face ((,c :inherit markdown-code-face :extend t)))
    `(markdown-blockquote-face ((,c :foreground ,kanagawa-comment :slant italic)))
    `(markdown-markup-face ((,c :foreground ,kanagawa-level-3)))
    `(markdown-list-face ((,c :foreground ,kanagawa-punctuation)))
    `(markdown-link-face ((,c :foreground ,kanagawa-function :underline t)))
    `(markdown-table-face ((,c :inherit fixed-pitch)))
    `(markdown-ts-bold ((,c :inherit bold)))
    `(markdown-ts-emphasis ((,c :inherit markdown-italic-face)))
    `(markdown-ts-heading-1 ((,c :inherit markdown-header-face-1)))
    `(markdown-ts-heading-2 ((,c :inherit markdown-header-face-2)))
    `(markdown-ts-heading-3 ((,c :inherit markdown-header-face-3)))
    `(markdown-ts-heading-4 ((,c :inherit markdown-header-face-4)))
    `(markdown-ts-heading-5 ((,c :inherit markdown-header-face-5)))
    `(markdown-ts-heading-6 ((,c :inherit markdown-header-face-6)))
    `(markdown-ts-code-span ((,c :inherit markdown-inline-code-face :background unspecified)))
    `(markdown-ts-code-block ((,c :inherit markdown-pre-face :extend t)))
    `(markdown-ts-indented-code-block ((,c :inherit markdown-ts-code-block)))
    `(markdown-ts-code-block-markup-hidden ((,c :background ,kanagawa-block-bg :extend t)))
    `(markdown-ts-block-quote ((,c :inherit markdown-blockquote-face)))
    `(markdown-ts-delimiter ((,c :inherit markdown-markup-face)))
    `(markdown-ts-list-marker ((,c :inherit markdown-list-face)))
    `(markdown-ts-link ((,c :inherit markdown-link-face)))
    `(markdown-ts-link-destination ((,c :foreground ,kanagawa-function :underline t)))
    `(markdown-ts-table ((,c :inherit markdown-table-face :extend t)))
    `(markdown-ts-table-header ((,c :inherit markdown-ts-table :foreground ,kanagawa-identifier :weight semi-bold)))
    `(markdown-ts-table-delimiter-cell ((,c :foreground ,kanagawa-level-3)))
