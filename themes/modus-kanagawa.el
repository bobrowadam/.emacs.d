;;; modus-kanagawa.el --- Kanagawa palettes on Modus Themes -*- lexical-binding: t; -*-

;;; Commentary:
;; Canonical Kanagawa Wave, Dragon, and Lotus palettes adapted to the
;; Modus Themes semantic palette and face infrastructure.
;; Sources:
;; https://github.com/rebelot/kanagawa.nvim/blob/master/lua/kanagawa/colors.lua
;; https://github.com/rebelot/kanagawa.nvim/blob/master/lua/kanagawa/themes.lua

;;; Code:

(require 'modus-themes)

(defgroup modus-kanagawa nil
  "Kanagawa palettes on the Modus Themes infrastructure."
  :group 'faces
  :group 'modus-themes
  :prefix "modus-kanagawa-")

(defconst modus-kanagawa-light-themes '(modus-kanagawa-lotus)
  "Light themes in the Modus Kanagawa family.")

(defconst modus-kanagawa-dark-themes
  '(modus-kanagawa-wave modus-kanagawa-dragon)
  "Dark themes in the Modus Kanagawa family.")

(defconst modus-kanagawa-items
  (append modus-kanagawa-light-themes modus-kanagawa-dark-themes)
  "All themes in the Modus Kanagawa family.")

