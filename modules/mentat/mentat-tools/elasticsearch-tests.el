;;; elasticsearch-tests.el --- Elastic MCP lifecycle tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'mentat-elisp-library)

(load (expand-file-name "elasticsearch.el"
                        (file-name-directory (or load-file-name buffer-file-name)))
      nil t t)

(ert-deftest mentat-elastic-mcp-preserves-registered-empty-objects ()
  (dolist (input '("[\"test\",{}]" "[\"test\",{\"query\":{}}]"))
    (let ((args (mentat--elisp-json-arguments
                 input "{}" '(tool arguments)))
          sent)
      (cl-letf (((symbol-function 'url-retrieve)
                 (lambda (&rest _) (setq sent url-request-data) nil)))
        (mentat-elastic-mcp--request "test-key" (car args) (cadr args)
                                     #'ignore #'ignore))
      (let* ((payload (json-parse-string (decode-coding-string sent 'utf-8)
                                         :null-object :null))
             (actual (gethash "arguments" (gethash "params" payload))))
        (should (hash-table-p actual))
        (when (cadr args)
          (should (hash-table-p (gethash "query" actual))))))))

(ert-deftest mentat-elastic-mcp-preserves-credential-rejections ()
  (dolist (category '(mentat-tool-authentication mentat-tool-cancelled))
    (let ((reason (list category "Credential failure"))
          failures reject-credential cleaned)
      (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
                 (lambda (_label _hosts _success reject &rest _options)
                   (setq reject-credential reject)
                   (funcall reject reason)
                   (lambda () (setq cleaned t))))
                ((symbol-function 'mentat-elastic-mcp--request)
                 (lambda (&rest _) (ert-fail "Unexpected HTTP request"))))
        (funcall (mentat-elastic-mcp--starter "test" nil)
                 #'ignore (lambda (value) (push value failures)) #'ignore)
        (funcall reject-credential reason)
        (should (= (length failures) 1))
        (should (eq (car failures) reason))
        (should cleaned)))))

(ert-deftest mentat-elastic-mcp-serializes-registered-array-arguments ()
  (let* ((arguments-json "[\"test\",{\"indices\":[\"logs-*\"],\"nested\":[{\"label\":\"שלום\"}],\"enabled\":false}]")
         (args (mentat--elisp-json-arguments
                arguments-json "{}" '(tool arguments)))
         sent)
    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (&rest _)
                 (setq sent url-request-data) nil)))
      (mentat-elastic-mcp--request "test-key" (car args) (cadr args)
                                   #'ignore #'ignore))
    (should-not (multibyte-string-p sent))
    (let* ((payload (json-parse-string (decode-coding-string sent 'utf-8)
                                      :object-type 'alist :array-type 'list
                                      :false-object :false))
           (actual (alist-get 'arguments (alist-get 'params payload))))
      (should (equal actual (cadr args))))))
(ert-deftest mentat-elastic-mcp-cancel-ignores-late-result ()
  (let (complete cancel results)
    (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
               (lambda (_label _hosts success _reject &rest _options)
                 (funcall success "test-key") #'ignore))
              ((symbol-function 'mentat-elastic-mcp--request)
               (lambda (_key _tool _args success _reject)
                 (setq complete success) nil)))
      (funcall (mentat-elastic-mcp--starter "test" nil)
               (lambda (value) (push value results)) #'ignore
               (lambda (cleanup) (setq cancel cleanup)))
      (funcall cancel)
      (funcall complete 'late)
      (should-not results))))

(ert-deftest mentat-elastic-mcp-startup-error-rejects ()
  (let (failure)
    (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
               (lambda (_label _hosts success _reject &rest _options)
                 (funcall success "test-key") #'ignore))
              ((symbol-function 'mentat-elastic-mcp--request)
               (lambda (&rest _) (error "Connection setup failed"))))
      (funcall (mentat-elastic-mcp--starter "test" nil)
               #'ignore (lambda (message) (setq failure message)) #'ignore)
      (should (string-match-p "Connection setup failed" failure)))))

(ert-deftest mentat-elastic-document-read-validates-before-authentication ()
  (dolist (args '(("logs-*/_delete_by_query" ((match_all)) ("@timestamp") 4)
                  ("logs-*" nil ("@timestamp") 4)
                  ("logs-*" ((match_all)) nil 4)
                  ("logs-*" ((match_all)) ("*") 4)
                  ("logs-*" ((match_all)) ("attributes.*") 4)
                  ("logs-*" ((match_all)) ("@timestamp") 0)
                  ("logs-*" ((match_all)) ("@timestamp") 101)))
    (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
               (lambda (&rest _) (ert-fail "Unexpected credential lookup"))))
      (should-error (apply #'mentat-elastic--read-documents-starter args)))))

(ert-deftest mentat-elastic-document-read-preserves-filtered-source-json ()
  (let* ((args (mentat--elisp-json-arguments
                "[\"logs-*\",{\"bool\":{\"filter\":[{\"term\":{\"enabled\":false}},{\"match_all\":{}}]}},[\"@timestamp\",\"attributes.event_loop_stack\"]]"
                "{}" '(index query source-fields)))
         url options result failure)
    (cl-letf (((symbol-function 'request)
               (lambda (target &rest settings)
                 (setq url target options settings) nil))
              ((symbol-function 'mentat-auth-source-secret-async)
               (lambda (_label _hosts success _reject &rest _options)
                 (funcall success "test-key") #'ignore)))
      (funcall (apply #'mentat-elastic--read-documents-starter
                      (append args '(4)))
               (lambda (value) (setq result value))
               (lambda (value) (setq failure value)) #'ignore)
      (should (string-prefix-p mentat-elastic-search-base-url url))
      (should (string-match-p "/_search?" url))
      (should (equal (plist-get options :type) "POST"))
      (let* ((body (json-parse-string
                    (decode-coding-string (plist-get options :data) 'utf-8)
                    :false-object :false))
             (filters (gethash "filter" (gethash "bool" (gethash "query" body)))))
        (should (= (gethash "size" body) 4))
        (should (equal (gethash "_source" body)
                       ["@timestamp" "attributes.event_loop_stack"]))
        (should (eq (gethash "enabled" (gethash "term" (aref filters 0))) :false))
        (should (hash-table-p (gethash "match_all" (aref filters 1)))))
      (let ((data (with-temp-buffer
                    (insert "{\"timed_out\":false,\"_shards\":{\"failed\":0},\"hits\":{\"hits\":[{\"_source\":{\"attributes\":{\"event_loop_stack\":[{\"function\":\"inner\",\"line\":7},{\"function\":\"outer\",\"line\":9}],\"optional\":null}}}]}}")
                    (goto-char (point-min))
                    (funcall (plist-get options :parser)))))
        (funcall (plist-get options :success) :data data)
        (should-not failure)
        (should (equal result (mentat-kibana--json-string data)))))))

(ert-deftest mentat-elastic-document-read-serialization-error-rejects ()
  (let (options failure)
    (cl-letf (((symbol-function 'request)
               (lambda (_target &rest settings) (setq options settings))))
      (mentat-elastic--document-request "test-key" "logs-*" nil
                                        #'ignore (lambda (value) (setq failure value))))
    (funcall (plist-get options :success) :data 'invalid-json-value)
    (should (stringp failure))))

(ert-deftest mentat-elastic-document-read-cancel-ignores-late-callbacks ()
  (let (cancel complete fail aborted cleaned results failures)
    (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
               (lambda (_label _hosts success _reject &rest _options)
                 (funcall success "test-key") (lambda () (setq cleaned t))))
              ((symbol-function 'mentat-elastic--document-request)
               (lambda (_key _index _body success reject)
                 (setq complete success fail reject) 'test-response))
              ((symbol-function 'request-abort)
               (lambda (response) (setq aborted response))))
      (funcall (mentat-elastic--read-documents-starter
                "logs-*" '((match_all)) '("@timestamp") 4)
               (lambda (value) (push value results))
               (lambda (value) (push value failures))
               (lambda (cleanup) (setq cancel cleanup)))
      (funcall cancel)
      (funcall complete 'late)
      (funcall fail 'late)
      (should (eq aborted 'test-response))
      (should cleaned)
      (should-not results)
      (should-not failures))))

(ert-deftest mentat-elastic-document-read-cancel-before-credentials ()
  (let (cancel supply-key cleaned)
    (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
               (lambda (_label _hosts success _reject &rest _options)
                 (setq supply-key success) (lambda () (setq cleaned t))))
              ((symbol-function 'mentat-elastic--document-request)
               (lambda (&rest _) (ert-fail "Unexpected HTTP request"))))
      (funcall (mentat-elastic--read-documents-starter
                "logs-*" '((match_all)) '("@timestamp") 4)
               #'ignore #'ignore (lambda (cleanup) (setq cancel cleanup)))
      (funcall cancel)
      (funcall supply-key "test-key")
      (should cleaned))))

(ert-deftest mentat-elastic-document-read-timeout-settles-once ()
  (let (expire complete failures aborted)
    (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
               (lambda (_label _hosts success _reject &rest _options)
                 (funcall success "test-key") #'ignore))
              ((symbol-function 'mentat-elastic--document-request)
               (lambda (_key _index _body success _reject)
                 (setq complete success) 'test-response))
              ((symbol-function 'run-at-time)
               (lambda (_seconds _repeat callback &rest _)
                 (setq expire callback) 'test-timer))
              ((symbol-function 'cancel-timer) #'ignore)
              ((symbol-function 'request-abort)
               (lambda (_response) (setq aborted t))))
      (funcall (mentat-elastic--read-documents-starter
                "logs-*" '((match_all)) '("@timestamp") 4)
               (lambda (_) (ert-fail "Unexpected success"))
               (lambda (value) (push value failures)) #'ignore)
      (funcall expire)
      (funcall complete 'late)
      (should aborted)
      (should (= (length failures) 1))
      (should (string-match-p "timed out" (car failures))))))

(ert-deftest mentat-elastic-mcp-timeout-settles-once ()
  (let (expire complete cancel failures results)
    (cl-letf (((symbol-function 'mentat-auth-source-secret-async)
               (lambda (_label _hosts success _reject &rest _options)
                 (funcall success "test-key") #'ignore))
              ((symbol-function 'mentat-elastic-mcp--request)
               (lambda (_key _tool _args success _reject)
                 (setq complete success) nil))
              ((symbol-function 'run-at-time)
               (lambda (_seconds _repeat callback &rest args)
                 (setq expire (lambda () (apply callback args))) 'test-timer))
              ((symbol-function 'cancel-timer) #'ignore))
      (funcall (mentat-elastic-mcp--starter "test" nil)
               (lambda (value) (push value results))
               (lambda (message) (push message failures))
               (lambda (cleanup) (setq cancel cleanup)))
      (should expire)
      (funcall expire)
      (funcall complete 'late)
      (funcall cancel)
      (should (= (length failures) 1))
      (should (string-match-p "test.*timed out" (car failures)))
      (should-not results))))
